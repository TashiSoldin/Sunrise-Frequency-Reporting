# Copy to .env and fill in. The real .env is gitignored — keep it that way.

# Parcel Perfect (Firebird) — report_generation and revenue_reports
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ROLE=

# Frequency, booking and POD reports — report_generation/helpers/os_helper.py
SENDER_EMAIL_ADDRESS=
SENDER_EMAIL_PASSWORD=

# Dashboarding reports — revenue_reports/mailer.py
DASHBOARDS_EMAIL_ADDRESS=
DASHBOARDS_EMAIL_PASSWORD=

# SharePoint delivery links — mcp_server/revenue.py. The web URL of the
# Claude General library root (the folder the BI server syncs as
# "Claude General - Documents"). Set = workbook tool responses also carry
# `link`, a URL that opens on any device; unset = local path only.
SHAREPOINT_LIBRARY_URL=

# MCP server auth — mcp_server/auth.py. All three unset = auth off; a partial set refuses to start.
AUTH_ISSUER=
AUTH_JWKS_URL=
AUTH_AUDIENCE=
AUTH_RESOURCE_URL=
# Optional: space-separated JWT algorithms, default RS256. Asymmetric only —
# anything else refuses to start.
AUTH_ALLOWED_ALGS=
